# Local sandbox defaults. Separate hosted values may be provided.
# Never commit a real credential.
AGENTMAIL_API_URL=http://127.0.0.1:3210/v0
AGENTMAIL_INBOX_ID=candidate@imap.test
AGENTMAIL_API_KEY=test_agentmail_key

IMAP_HOST=127.0.0.1
IMAP_PORT=1143

# Optional server tuning (defaults shown). AGENTMAIL_API_KEY above is used only by the smoke
# script; the server takes credentials from the IMAP LOGIN command.
# IMAPGW_DB_PATH=imapgw.sqlite3
# IMAPGW_HTTP_TIMEOUT=10
# IMAPGW_HTTP_RETRIES=3
# IMAPGW_IDLE_TIMEOUT=1800
# IMAPGW_COMMAND_TIMEOUT=30
# IMAPGW_MAX_CONNECTIONS=100
# IMAPGW_REFRESH_INTERVAL=5
# IMAPGW_ASSEMBLY_TIMEOUT=60      # seconds to finish assembling one command (literals included)
# IMAPGW_WRITE_TIMEOUT=30         # seconds a client may stall before we drop it
# IMAPGW_POST_COMMAND_WAIT=2      # seconds to wait for the re-listing after an APPEND has answered OK
# IMAPGW_MAX_LINE=65536           # bytes per command line
# IMAPGW_MAX_LITERAL=1048576      # bytes per literal
# IMAPGW_MAX_COMMAND_BYTES=1114112  # bytes per command, literals included
# IMAPGW_MAX_LITERALS=16          # literals per command
# IMAPGW_LOG_LEVEL=INFO
